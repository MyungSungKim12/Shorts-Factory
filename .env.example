# 복사해서 .env로 저장 후 값 채우기 (.env는 절대 커밋 금지)
# Gemini 무료 API (리서처 주력 — 검색 그라운딩)
# 발급: https://aistudio.google.com/app/apikey (구글 계정만 있으면 무료)
GEMINI_API_KEY=여기에_발급받은_키_입력
GEMINI_MODEL=gemini-flash-latest

# Groq 무료 API (작가 주력 + Gemini 폴백)
# 발급: https://console.groq.com (무료 가입 → API Keys)
GROQ_API_KEY=여기에_발급받은_키_입력
GROQ_MODEL=openai/gpt-oss-120b
GROQ_GROUNDED_MODEL=groq/compound

# 이미지/영상 관련
PEXELS_API_KEY=여기에_발급받은_키_입력
PIXABAY_API_KEY=
FFMPEG_PATH=D:\ms\ffmpeg-8.1.2-essentials_build\bin\ffmpeg.exe

# 경로/권한 설정
DATA_DIR=./data
UPLOAD_PRIVACY=public
DAILY_UPLOAD_LIMIT=4

# 채널명 (영상 첫 1.8초 오프닝 브랜딩에 표시. 비우면 오프닝 생략)
CHANNEL_NAME=이상한 지구기록

# YouTube Data API 키 (분석가의 공개 조회수 수집용 — OAuth 아닌 단순 키)
# 발급: Google Cloud Console → 사용자 인증정보 → API 키 만들기 (업로드 프로젝트에서)
YOUTUBE_API_KEY=여기에_발급받은_키_입력

# 나레이션 배속 (1.0=원속, 1.2=20% 빠르게)
TTS_SPEED=1.2

# 콘텐츠/보이스 선택 (story 샘플은 Google ADC 인증 사용)
# 현재 운영 방식: 스토리형 영상 + Google 여성 음성
# Google TTS 실패 시 코드가 gTTS로 자동 폴백한다.
CONTENT_FORMAT=story
TTS_PROVIDER=auto
TTS_VOICE=ko-KR-Chirp3-HD-Kore
TTS_SPEAKING_RATE=1.0
TTS_PITCH=0.0
GEMINI_TTS_MODEL=gemini-2.5-flash-tts
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_STYLE_PROMPT=차분하고 자연스러운 한국인 여성 미스터리 다큐멘터리 진행자처럼 말한다. 쉼표와 문장 경계에서 자연스럽게 쉰다.

# 검증된 실제 이미지를 첫 프레임으로 사용하는 Vertex AI Veo 오프닝
# false이면 기존 무료 스톡만 사용하며, 실패 시에도 자동으로 스톡으로 폴백합니다.
GOOGLE_CLOUD_PROJECT=shorts-factory-502004
GOOGLE_CLOUD_LOCATION=global
VERTEX_GEMINI_MODEL=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=true
VEO_OPENING_ENABLED=false
VEO_MODEL=veo-3.1-fast-generate-001
VEO_OPENING_MAX_SEC=3.0
VEO_CANDIDATES=2
VEO_TIMEOUT_SEC=900
VEO_POLL_SEC=15

# Google Cloud 체험 크레딧 자동 전환. free에서는 신규 Vertex/Veo/Gemini TTS를 호출하지 않는다.
AI_CREDIT_MODE=auto
CLOUD_CREDIT_START_KRW=460418
CLOUD_CREDIT_FLOOR_KRW=80000
CLOUD_USD_TO_KRW=1400
CLOUD_CREDIT_EXPIRES_AT=2026-10-09
CLOUD_CREDIT_EXPIRY_SAFETY_DAYS=3
DISK_USAGE_WARN_PERCENT=75
AI_LIBRARY_WARN_BYTES=10737418240

# 자막 폰트 (Windows: Malgun Gothic / 리눅스 서버: NanumGothic)
SUBTITLE_FONT=Malgun Gothic

# BGM 볼륨 (assets/bgm/에 mp3를 넣으면 자동으로 깔림, 0.1~0.2 권장)
BGM_VOLUME=0.12

# 선택 사항: Telegram 운영 알림 (명시적으로 true일 때만 활성화)
# BotFather에서 발급한 토큰과 대상 채팅 ID를 실제 .env에만 입력하세요.
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 대시보드 수동 실행 API 보호 토큰 (실제 값은 서버 .env에만 저장)
DASHBOARD_TOKEN=
